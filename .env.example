# ─── Database ───────────────────────────────────────────────
# Pooled connection (Neon: host contains "-pooler")
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct connection (no pooler) — used for migrations
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth ───────────────────────────────────────────────────
# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public URL of the app, no trailing slash (used in email links)
APP_URL="https://yourdomain.com"

# ─── Email (Resend) ─────────────────────────────────────────
# Without this, verification/reset links are logged to the server console (dev only).
RESEND_API_KEY=""
EMAIL_FROM="GrowthMatrix <no-reply@yourdomain.com>"

# ─── Admin ──────────────────────────────────────────────────
# Comma-separated emails granted owner/superadmin access
ADMIN_EMAILS="you@yourdomain.com"

# ─── Legal / company identity (shown on /terms and /privacy) ─
COMPANY_NAME="Your Company Ltd."
COMPANY_CONTACT_EMAIL="privacy@yourdomain.com"
COMPANY_ADDRESS=""
